<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/deviceNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Telefon nomi (masalan: Onam telefoni)"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSaveDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Номни сақлаш"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Рухсат бериш"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSyncHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Тарихни юбориш"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnNotificationAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Telegram рухсатини очиш" />

</LinearLayout>
